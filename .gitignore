# Dependencies
node_modules/

# Native platforms are regenerated in CI via `npx cap add ios`
/ios/
/android/

# Build outputs / packaging
/build/
Payload/
*.ipa

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
.vscode/

# Scratch files from test runs (npm test > _t.txt)
_*.txt
*.verify*

# assets/ carries Python build tooling (square-icons.py and friends)
__pycache__/

# F248: UI mockups, regenerated by: node assets/mockups.js
# NOT committed, and that is measured, not fussy: one run is 0.81 MB and git
# keeps every version FOREVER, so a release a day is ~294 MB/yr against the
# 1 GB soft limit — the identical trap backlog item 1 documents, where
# committed map images reached 330 MB and retention could only tidy the
# checkout. They are uploaded as RELEASE ASSETS instead, the same way the
# .ipa is: viewable on github.com, zero git history.
/mockups/
